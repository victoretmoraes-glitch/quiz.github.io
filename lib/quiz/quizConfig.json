{
  "meta": {
    "id": "quiz-emagrecimento-imc-v1",
    "name": "Descubra seu Plano Personalizado",
    "locale": "pt-BR",
    "version": "1.0.0",
    "description": "Quiz de qualificacao com calculo de IMC e redirect para checkout.",
    "ogImageUrl": "/og-quiz.jpg"
  },
  "theme": {
    "primaryColor": "#7C3AED",
    "secondaryColor": "#F59E0B",
    "backgroundColor": "#0B1020",
    "textColor": "#F8FAFC",
    "fontFamily": "Inter, sans-serif",
    "borderRadius": "xl",
    "logoUrl": "/logo.svg"
  },
  "tracking": {
    "captureParams": [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_content",
      "utm_term",
      "src"
    ],
    "persist": true,
    "storageKey": "quiz_tracking",
    "pixels": {
      "facebook": { "pixelId": "000000000000000", "events": ["PageView", "Lead"] }
    }
  },
  "variables": [
    { "key": "objetivo", "type": "string", "description": "Objetivo principal do usuario" },
    { "key": "habitos", "type": "array", "defaultValue": [], "description": "Habitos selecionados" },
    { "key": "peso", "type": "number", "required": true },
    { "key": "altura", "type": "number", "required": true },
    { "key": "imc", "type": "number", "description": "Calculado no frontend" },
    { "key": "imcCategoria", "type": "string" },
    { "key": "imcMensagem", "type": "string" },
    { "key": "nome", "type": "string", "required": true },
    { "key": "email", "type": "string", "required": true }
  ],
  "startStepId": "step_objetivo",
  "steps": [
    {
      "id": "step_objetivo",
      "type": "image-grid",
      "title": "Qual e o seu principal objetivo?",
      "subtitle": "Escolha a opcao que mais combina com voce.",
      "variableKey": "objetivo",
      "columns": 2,
      "showProgressBar": true,
      "autoAdvance": true,
      "options": [
        {
          "id": "opt_emagrecer",
          "label": "Emagrecer com saude",
          "value": "emagrecer",
          "imageUrl": "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=600"
        },
        {
          "id": "opt_definir",
          "label": "Definir o corpo",
          "value": "definir",
          "imageUrl": "https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=600"
        },
        {
          "id": "opt_energia",
          "label": "Ter mais energia",
          "value": "energia",
          "imageUrl": "https://images.unsplash.com/photo-1518611012118-696072aa579a?w=600"
        },
        {
          "id": "opt_massa",
          "label": "Ganhar massa magra",
          "value": "massa",
          "imageUrl": "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=600"
        }
      ],
      "nextStepId": "step_habitos"
    },
    {
      "id": "step_habitos",
      "type": "list-multiple",
      "title": "Quais destes habitos fazem parte da sua rotina?",
      "subtitle": "Selecione todos que se aplicam.",
      "variableKey": "habitos",
      "minSelections": 1,
      "showProgressBar": true,
      "ctaLabel": "Continuar",
      "options": [
        { "id": "h1", "label": "Como doces com frequencia", "value": "doces", "iconName": "Candy" },
        { "id": "h2", "label": "Bebo pouca agua", "value": "pouca_agua", "iconName": "Droplet" },
        { "id": "h3", "label": "Durmo mal", "value": "sono_ruim", "iconName": "Moon" },
        { "id": "h4", "label": "Sedentario(a)", "value": "sedentario", "iconName": "Sofa" },
        { "id": "h5", "label": "Nenhuma das anteriores", "value": "nenhuma", "iconName": "X", "exclusive": true }
      ],
      "nextStepId": "step_peso_altura"
    },
    {
      "id": "step_peso_altura",
      "type": "input-number",
      "title": "Vamos calcular seu IMC",
      "subtitle": "Informe seus dados atuais.",
      "showProgressBar": true,
      "ctaLabel": "Calcular meu IMC",
      "fields": [
        {
          "variableKey": "peso",
          "label": "Seu peso atual",
          "placeholder": "Ex: 72",
          "unit": "kg",
          "min": 30,
          "max": 300,
          "step": 0.1,
          "required": true,
          "errorMessage": "Informe um peso valido entre 30 e 300 kg."
        },
        {
          "variableKey": "altura",
          "label": "Sua altura",
          "placeholder": "Ex: 170",
          "unit": "cm",
          "min": 100,
          "max": 250,
          "step": 1,
          "required": true,
          "errorMessage": "Informe uma altura valida entre 100 e 250 cm."
        }
      ],
      "nextStepId": "step_analisando"
    },
    {
      "id": "step_analisando",
      "type": "interstitial",
      "variant": "loading",
      "title": "Analisando seu perfil...",
      "subtitle": "Nossa IA esta calculando seu IMC e cruzando com o seu objetivo.",
      "autoAdvanceMs": 3500,
      "loadingMessages": [
        "Calculando seu IMC...",
        "Cruzando dados com o seu objetivo...",
        "Selecionando o melhor plano para voce..."
      ],
      "socialProof": {
        "avatars": [
          "https://i.pravatar.cc/64?img=32",
          "https://i.pravatar.cc/64?img=45",
          "https://i.pravatar.cc/64?img=12"
        ],
        "text": "+12.398 pessoas ja descobriram seu plano ideal esta semana"
      },
      "onEnter": [
        {
          "type": "computeBMI",
          "weightKey": "peso",
          "heightKey": "altura",
          "outputKey": "imc",
          "decimals": 1
        },
        {
          "type": "categorize",
          "inputKey": "imc",
          "outputKey": "imcCategoria",
          "outputMessageKey": "imcMensagem",
          "ranges": [
            {
              "max": 25,
              "label": "Normal",
              "message": "Seu IMC de {{imc}} esta dentro da faixa saudavel. Vamos manter e otimizar seus resultados!"
            },
            {
              "min": 25,
              "max": 30,
              "label": "Acima do peso",
              "message": "Seu IMC de {{imc}} indica sobrepeso. Preparamos um plano especifico para reverter isso rapido."
            },
            {
              "min": 30,
              "label": "Obeso",
              "message": "Seu IMC de {{imc}} indica obesidade. Voce precisa de um plano estruturado e nos vamos te guiar."
            }
          ]
        },
        {
          "type": "trackEvent",
          "eventName": "BMICalculated",
          "targets": ["facebook"]
        }
      ],
      "nextStepId": "step_resultado_imc"
    },
    {
      "id": "step_resultado_imc",
      "type": "result",
      "title": "Seu resultado esta pronto",
      "headline": "IMC: {{imc}} — {{imcCategoria}}",
      "body": "{{imcMensagem}}",
      "showProgressBar": true,
      "ctaLabel": "Ver meu plano personalizado",
      "highlights": [
        { "label": "Seu IMC", "value": "{{imc}}", "icon": "Activity" },
        { "label": "Classificacao", "value": "{{imcCategoria}}", "icon": "Target" },
        { "label": "Objetivo", "value": "{{objetivo}}", "icon": "Flag" }
      ],
      "transitions": [
        {
          "when": [{ "variableKey": "imcCategoria", "operator": "eq", "value": "Normal" }],
          "goToStepId": "step_captura_lead"
        },
        {
          "when": [{ "variableKey": "imcCategoria", "operator": "eq", "value": "Acima do peso" }],
          "goToStepId": "step_captura_lead"
        },
        {
          "when": [{ "variableKey": "imcCategoria", "operator": "eq", "value": "Obeso" }],
          "goToStepId": "step_captura_lead"
        }
      ],
      "nextStepId": "step_captura_lead"
    },
    {
      "id": "step_captura_lead",
      "type": "input-text",
      "title": "Ultimo passo, {{objetivo}} de forma personalizada",
      "subtitle": "Deixe seus dados para receber seu plano exclusivo.",
      "showProgressBar": true,
      "ctaLabel": "Quero meu plano agora",
      "fields": [
        {
          "variableKey": "nome",
          "label": "Seu primeiro nome",
          "placeholder": "Ex: Maria",
          "inputType": "text",
          "required": true,
          "minLength": 2,
          "errorMessage": "Informe seu nome."
        },
        {
          "variableKey": "email",
          "label": "Seu melhor e-mail",
          "placeholder": "voce@email.com",
          "inputType": "email",
          "required": true,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "errorMessage": "Informe um e-mail valido."
        }
      ],
      "onExit": [
        {
          "type": "trackEvent",
          "eventName": "Lead",
          "targets": ["facebook", "gtm"]
        }
      ],
      "nextStepId": "step_redirect_checkout"
    },
    {
      "id": "step_redirect_checkout",
      "type": "checkout-redirect",
      "title": "Preparando seu plano, {{nome}}...",
      "subtitle": "Voce sera redirecionado(a) em instantes.",
      "baseUrl": "https://checkout.exemplo.com/oferta-especial",
      "appendParams": {
        "name": "{{nome}}",
        "email": "{{email}}",
        "imc": "{{imc}}",
        "categoria": "{{imcCategoria}}",
        "objetivo": "{{objetivo}}",
        "utm_source": "{{tracking.utm_source}}",
        "utm_medium": "{{tracking.utm_medium}}",
        "utm_campaign": "{{tracking.utm_campaign}}",
        "utm_content": "{{tracking.utm_content}}",
        "utm_term": "{{tracking.utm_term}}",
        "src": "{{tracking.src}}"
      },
      "autoRedirectMs": 2500,
      "openInNewTab": false,
      "buttonLabel": "Ir para meu plano agora"
    }
  ]
}
